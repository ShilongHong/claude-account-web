#!/usr/bin/env python3
"""Pin selected CODEX_HOME before launching the official Codex CLI."""
import os
from pathlib import Path
import shutil
import sys

selected = Path(os.environ.get('CODEX_HOME', str(Path.home() / '.local/share/claude-account-web/codex/current'))).expanduser().resolve(strict=True)
binary = os.environ.get('CLAUDE_ACCOUNT_WEB_REAL_CODEX') or shutil.which('codex')
if not binary and (Path.home() / '.npm-global/bin/codex').is_file():
    binary = str(Path.home() / '.npm-global/bin/codex')
if not binary or Path(binary).resolve() == Path(__file__).resolve():
    raise SystemExit('未找到官方 Codex CLI。')
os.execvpe(binary, [binary, *sys.argv[1:]], dict(os.environ, CODEX_HOME=str(selected)))
